<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/welcomeLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_bg"
    tools:context=".WelcomeActivity">

    <ImageView
        android:id="@+id/logoImage"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:src="@drawable/home_icon"
        android:contentDescription="@string/app_name"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/appName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="100dp" />

    <!-- App Name (Stylish Gradient + Shadow + Glow) -->
    <TextView
        android:id="@+id/appName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HomeVista"
        android:textSize="40sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.05"
        android:textColor="@android:color/white"
        android:shadowColor="#4D90FE"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="10"
        app:layout_constraintTop_toBottomOf="@id/logoImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:padding="4dp"
        android:background="@drawable/text_gradient_bg"
        android:clipToOutline="true" />


    <!-- Tagline (Elegant Accent Text) -->
    <TextView
        android:id="@+id/tagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Find • Buy • Rent — All in One Place"
        android:textSize="18sp"
        android:fontFamily="sans-serif-medium"
        android:textStyle="italic"
        android:textColor="#E3F2FD"
        android:shadowColor="#263238"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="5"
        app:layout_constraintTop_toBottomOf="@id/appName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp"
        android:letterSpacing="0.02"
        android:lineSpacingExtra="4dp" />


    <LinearLayout
        android:id="@+id/buttonContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/tagline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="50dp">

        <Button
            android:id="@+id/loginBtn"
            android:layout_width="250dp"
            android:layout_height="50dp"
            android:text="Sign In"
            android:textStyle="bold"
            android:backgroundTint="#00C853"
            android:textColor="@android:color/white"
            android:layout_marginBottom="12dp"
            android:drawableLeft="@drawable/ic_login" />

        <Button
            android:id="@+id/registerBtn"
            android:layout_width="250dp"
            android:layout_height="50dp"
            android:text="Create Account"
            android:textStyle="bold"
            android:backgroundTint="#2962FF"
            android:textColor="@android:color/white"
            android:layout_marginBottom="12dp"
            android:drawableLeft="@drawable/ic_register" />

        <Button
            android:id="@+id/guestBtn"
            android:layout_width="250dp"
            android:layout_height="50dp"
            android:text="Continue as Guest"
            android:textStyle="bold"
            android:backgroundTint="#757575"
            android:textColor="@android:color/white"
            android:drawableLeft="@drawable/ic_guest" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
