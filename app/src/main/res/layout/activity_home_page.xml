<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".HomePage">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:fadingEdgeLength="50dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="0dp">

            <!-- HEADER CARD -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="280dp"
                app:cardCornerRadius="0dp"
                app:cardElevation="8dp"
                android:layout_marginBottom="10dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:background="@drawable/gradient_bg"
                    android:padding="20dp">

                    <!-- PROFILE ICON -->
                    <ImageView
                        android:id="@+id/profileIcon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/circle_white_bg"
                        android:elevation="4dp"
                        android:padding="8dp"
                        android:scaleX="1"
                        android:scaleY="1"
                        android:src="@drawable/home_icon"
                        android:translationY="0dp" />


                    <!-- WELCOME TEXT -->
                    <TextView
                        android:id="@+id/welcomeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_marginTop="10dp"
                        android:alpha="0.8"
                        android:text="Welcome back!"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"/>
                    <!-- MAIN HEADER TEXT -->
                    <TextView
                        android:id="@+id/headerTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/welcomeText"
                        android:layout_alignParentStart="true"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="4dp"
                        android:text="Find Your Dream Home"
                        android:textColor="@color/white"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <!-- OPTIONAL SUBTITLE -->
                    <TextView
                        android:id="@+id/subTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/headerTitle"
                        android:layout_alignParentStart="true"
                        android:layout_marginTop="6dp"
                        android:alpha="0.9"
                        android:text="Discover the perfect property for your needs"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                    <!-- STATS BAR -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_marginBottom="20dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="500+"
                                android:textColor="@color/white"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                tools:ignore="HardcodedText" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:alpha="0.8"
                                android:text="Properties"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                tools:ignore="HardcodedText" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="30dp"
                            android:alpha="0.3"
                            android:background="@color/white" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="50+"
                                android:textColor="@color/white"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:alpha="0.8"
                                android:text="Locations"
                                android:textColor="@color/white"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="30dp"
                            android:alpha="0.3"
                            android:background="@color/white" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="98%"
                                android:textColor="@color/white"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:alpha="0.8"
                                android:text="Satisfaction"
                                android:textColor="@color/white"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- SEARCH BAR -->
            <androidx.cardview.widget.CardView
                android:id="@+id/searchCardView"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="30dp"
                app:cardElevation="14dp"
                android:clipToOutline="true"
                android:background="@drawable/circle_white_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Search Icon -->
                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_search"
                        app:tint="@color/purple_800"/>

                    <!-- Search Input -->
                    <EditText
                        android:id="@+id/searchInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="15dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="Search properties, locations..."
                        android:minHeight="48dp"
                        android:textColor="@color/black"
                        android:textColorHint="#993B2667"
                        android:textSize="16sp"
                        android:padding="0dp"
                        android:inputType="text" />

                    <!-- Mic Button -->
                    <ImageView
                        android:id="@+id/micButton"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginEnd="10dp"
                        android:src="@drawable/ic_mic"
                        app:tint="@color/purple_700"
                        android:padding="4dp" />

                    <!-- Filter Icon -->
                    <ImageView
                        android:id="@+id/filterIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_filter"
                        app:tint="@color/purple_700"
                        android:padding="5dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- QUICK ACTIONS TITLE -->
            <TextView
                android:id="@+id/servicesTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Our Services"
                android:textColor="@color/black"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginStart="25dp"
                android:layout_marginTop="20dp"
                android:letterSpacing="0.02"
                android:fontFamily="sans-serif-medium" />

            <!-- QUICK ACTIONS CARDS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3"
                android:padding="16dp"
                android:gravity="center_vertical">

                <!-- BUY CARD -->
                <!-- QUICK ACTIONS CARDS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <!-- BUY CARD -->
                    <LinearLayout
                        android:id="@+id/buyLayout"
                        android:layout_width="0dp"
                        android:layout_height="140dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_service_buy"
                        android:padding="16dp"
                        android:elevation="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginEnd="8dp"
                        android:clipToOutline="true">

                        <ImageView
                            android:id="@+id/iconBuy"
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:src="@drawable/ic_buy"
                            android:contentDescription="Buy"
                            android:layout_gravity="center" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Buy"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="@color/white"
                            android:layout_marginTop="10dp"
                            android:letterSpacing="0.02"/>
                    </LinearLayout>

                    <!-- RENT CARD -->
                    <LinearLayout
                        android:id="@+id/rentLayout"
                        android:layout_width="0dp"
                        android:layout_height="140dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_service_rent"
                        android:padding="16dp"
                        android:elevation="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:clipToOutline="true">

                        <ImageView
                            android:id="@+id/iconRent"
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:src="@drawable/ic_rent"
                            android:contentDescription="Rent"
                            android:layout_gravity="center" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rent"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="@color/white"
                            android:layout_marginTop="10dp"
                            android:letterSpacing="0.02"/>
                    </LinearLayout>

                    <!-- SELL CARD -->
                    <LinearLayout
                        android:id="@+id/sellLayout"
                        android:layout_width="0dp"
                        android:layout_height="140dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_service_sell"
                        android:padding="16dp"
                        android:elevation="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginStart="8dp"
                        android:clipToOutline="true">

                        <ImageView
                            android:id="@+id/iconSell"
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:src="@drawable/ic_sell"
                            android:contentDescription="Sell"
                            android:layout_gravity="center" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sell"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="@color/white"
                            android:layout_marginTop="10dp"
                            android:letterSpacing="0.02"/>
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>

            <!-- FEATURED TITLE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="25dp"
                android:layout_marginEnd="25dp"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/featuredPropertiesTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Featured Properties"
                    android:textColor="@color/black"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/seeAllText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="See All"
                    android:textColor="@color/purple_600"
                    android:textStyle="bold"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- MODERN PROPERTY SLIDER -->
            <HorizontalScrollView
                android:id="@+id/propertySlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- PROPERTY CARD 1 -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/propertyCard1"
                        android:layout_width="280dp"
                        android:layout_height="340dp"
                        android:layout_marginEnd="18dp"
                        android:clipToOutline="true"
                        app:cardCornerRadius="22dp"
                        app:cardUseCompatPadding="true"
                        app:cardElevation="14dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:id="@+id/propertyImage1"
                                android:layout_width="match_parent"
                                android:layout_height="200dp"
                                android:scaleType="centerCrop"
                                android:src="@drawable/villa" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="200dp"
                                android:background="@drawable/property_gradient" />

                            <ImageView
                                android:id="@+id/heart1"
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:layout_alignParentEnd="true"
                                android:layout_margin="12dp"
                                android:background="@drawable/round_white_glass"
                                android:padding="10dp"
                                android:src="@drawable/ic_heart_outline"
                                app:tint="@android:color/white"
                                android:elevation="6dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Luxury Villa"
                                android:textStyle="bold"
                                android:textSize="20sp"
                                android:textColor="@android:color/white"
                                android:layout_marginStart="16dp"
                                android:layout_alignBottom="@id/propertyImage1"
                                android:layout_marginBottom="18dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$950,000"
                                android:textStyle="bold"
                                android:textSize="18sp"
                                android:textColor="@color/purple_300"
                                android:layout_marginStart="16dp"
                                android:layout_below="@id/propertyImage1"
                                android:layout_marginTop="12dp" />

                            <!-- LOCATION -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginStart="16dp"
                                android:layout_below="@id/propertyImage1"
                                android:layout_marginTop="44dp">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_location"
                                    app:tint="@android:color/white" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Los Angeles, CA"
                                    android:textColor="@android:color/white"
                                    android:layout_marginStart="6dp"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <!-- FEATURES -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginStart="16dp"
                                android:layout_below="@id/propertyImage1"
                                android:layout_marginTop="84dp">

                                <ImageView
                                    android:layout_width="17dp"
                                    android:layout_height="17dp"
                                    android:src="@drawable/ic_bed"
                                    app:tint="@android:color/white" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="4 Beds"
                                    android:textColor="@android:color/white"
                                    android:textSize="13sp"
                                    android:layout_marginStart="6dp" />
                            </LinearLayout>

                        </RelativeLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- PROPERTY CARD 2 -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/propertyCard2"
                        android:layout_width="280dp"
                        android:layout_height="340dp"
                        android:layout_marginEnd="18dp"
                        android:clipToOutline="true"
                        app:cardCornerRadius="22dp"
                        app:cardUseCompatPadding="true"
                        app:cardElevation="14dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:id="@+id/propertyImage2"
                                android:layout_width="match_parent"
                                android:layout_height="200dp"
                                android:scaleType="centerCrop"
                                android:src="@drawable/icon1" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="200dp"
                                android:background="@drawable/property_gradient" />

                            <ImageView
                                android:id="@+id/heart2"
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:layout_alignParentEnd="true"
                                android:layout_margin="12dp"
                                android:background="@drawable/round_white_glass"
                                android:padding="10dp"
                                android:src="@drawable/ic_heart_outline"
                                app:tint="@android:color/white"
                                android:elevation="6dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Modern Apartment"
                                android:textStyle="bold"
                                android:textSize="20sp"
                                android:textColor="@android:color/white"
                                android:layout_marginStart="16dp"
                                android:layout_alignBottom="@id/propertyImage2"
                                android:layout_marginBottom="18dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$580,000"
                                android:textStyle="bold"
                                android:textSize="18sp"
                                android:textColor="@color/purple_300"
                                android:layout_marginStart="16dp"
                                android:layout_below="@id/propertyImage2"
                                android:layout_marginTop="12dp" />

                            <!-- LOCATION -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginStart="16dp"
                                android:layout_below="@id/propertyImage2"
                                android:layout_marginTop="44dp">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_location"
                                    app:tint="@android:color/white" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="New York, NY"
                                    android:textColor="@android:color/white"
                                    android:layout_marginStart="6dp"
                                    android:textSize="13sp" />
                            </LinearLayout>

                        </RelativeLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>
            </HorizontalScrollView>




        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
